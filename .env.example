# .env.example -- Copy this to .env and fill in your values
# NEVER commit the actual .env file

# ── Perplexity API ──────────────────────────────────────────
# Get your key at: https://www.perplexity.ai/account/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# ── Nano Banana (Kie.ai) ───────────────────────────────────
# Get your key at: https://kie.ai (API settings)
NANO_BANANA_API_KEY=
NANO_BANANA_API_URL=https://kie.ai/api/v1/generate

# ── Google Sheets (Subscribers) ─────────────────────────────
# The long ID from your sheet URL: docs.google.com/spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEET_ID=
SUBSCRIBERS_SHEET_NAME=Sheet1

# ── Gmail Sender ────────────────────────────────────────────
SENDER_NAME=
SENDER_EMAIL=

# ── Newsletter Branding ────────────────────────────────────
NEWSLETTER_NAME=The Weekly Brief
